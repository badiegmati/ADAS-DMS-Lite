# Copier ce fichier en .env puis remplir les valeurs (cmd : copy .env.example .env)

# URL du projet Supabase et clé "anon" (Project Settings > API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...

# Code du conducteur (doit exister dans la table conducteurs)
CONDUCTEUR_CODE=C10

# Index de la webcam du PC (0 = webcam intégrée)
CAMERA_INDEX=0

# Afficher la fenêtre de prévisualisation (1 = oui, 0 = non)
SHOW_PREVIEW=1
