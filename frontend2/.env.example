# Laisser vide en local : le proxy Vite relaie /api vers http://localhost:8080
# En production (Vercel) : laisser VIDE aussi : vercel.json relaie /api vers le backend Render (cookie en premier parti)
VITE_API_URL=
# Affiche, sur la page de connexion, un bouton « compte de démonstration » (true/false)
VITE_SHOW_DEMO=true
