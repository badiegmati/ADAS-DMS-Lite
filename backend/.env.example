# Copier en .env (cmd : copy .env.example .env) puis remplir.
# Supabase > Project Settings > Database > Connection string > onglet "Transaction pooler"
DB_URL=jdbc:postgresql://aws-0-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0

DB_USER=postgres.votre_ref_projet
DB_PASSWORD=votre_mot_de_passe_db

# Au moins 32 caracteres aleatoires (ex. openssl rand -hex 32)
JWT_SECRET=remplacer_par_une_longue_valeur_aleatoire_de_32_caracteres_minimum

# Gemini (offre gratuite) : https://aistudio.google.com/apikey
GEMINI_API_KEY=votre_cle_gemini
GEMINI_MODEL=gemini-2.5-flash

# Compte administrateur cree au premier demarrage (identifiant : admin)
ADMIN_DEFAULT_PASSWORD=changez_moi_au_premier_demarrage

# Mettre none en cas d'erreur "wrong column type" au demarrage
JPA_DDL_AUTO=validate
